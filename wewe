-- ========== SCRIPT BUTTONS ==========
local function makeButton(text, yPos, url, c1, c2)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -24, 0, 54)
    btn.Position = UDim2.new(0, 12, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBlack
    btn.TextSize = 16
    btn.AutoButtonColor = false
    btn.Parent = frame
    corner(btn, 12)
    gradient(btn, c1, c2, 0)
    local s = stroke(btn, Color3.fromRGB(255, 255, 255), 1)
    s.Transparency = 0.7

    btn.MouseEnter:Connect(function()
        tween(btn, 0.15, { Size = UDim2.new(1, -16, 0, 58), Position = UDim2.new(0, 8, 0, yPos - 2) })
        tween(s, 0.15, { Transparency = 0 })
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.15, { Size = UDim2.new(1, -24, 0, 54), Position = UDim2.new(0, 12, 0, yPos) })
        tween(s, 0.15, { Transparency = 0.7 })
    end)

    btn.MouseButton1Click:Connect(function()
        btn.Text = "⏳ Loading..."
        local ok = pcall(function()
            loadstring(game:HttpGet(url))()
        end)
        btn.Text = ok and "✅ Loaded!" or "❌ Failed"
        task.wait(2)
        btn.Text = text
    end)
end

