-- SETTINGS
local INTRO_TIME = 5
local INTRO_TIMEOUT = 40

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- ========== INTRO + WAIT ==========
local containers = { LocalPlayer:WaitForChild("PlayerGui") }
pcall(function() table.insert(containers, CoreGui) end)
if gethui then pcall(function() table.insert(containers, gethui()) end) end

local before = {}
for _, c in ipairs(containers) do
    for _, g in ipairs(c:GetChildren()) do before[g] = true end
end

pcall(function()
    loadstring(game:HttpGet("https://pastebin.com/raw/DBzgFdTC"))()
end)

task.wait(0.5)
local introGuis = {}
for _, c in ipairs(containers) do
    for _, g in ipairs(c:GetChildren()) do
        if not before[g] and g:IsA("ScreenGui") then table.insert(introGuis, g) end
    end
end

if #introGuis > 0 then
    local t = 0
    while t < INTRO_TIMEOUT do
        local alive = false
        for _, g in ipairs(introGuis) do
            if g.Parent then alive = true break end
        end
        if not alive then break end
        task.wait(0.25)
        t += 0.25
    end
else
    task.wait(INTRO_TIME)
end

-- ========== HELPERS ==========
local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r)
    c.Parent = obj
    return c
end

local function stroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thickness
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    return s
end

local function gradient(obj, c1, c2, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(c1, c2)
    g.Rotation = rot or 90
    g.Parent = obj
    return g
end

local function tween(obj, time, props, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

